#!/usr/bin/env bash
# Controls the Bannerlord dedicated server on this machine.
#
# Usage: mpm <command> [args]
#   cmd <command...>     run a command and print the server's answer: chat commands (mpm cmd maps) or
#                        console commands and options (mpm cmd MaxNumberOfPlayers 20)
#   logs [-f] [-n N]     the last N (default 50) log lines without noise, -f to follow; --all: unfiltered
#   perf [-n N] [--players]  the last N (default 12, two minutes) rows of this run's server metrics, or with
#                        --players the per-player ones (ping, jitter, loss); columns are explained in Metrics.cs
#   start [options]      start the server in the background; options go to run-server.sh
#   stop | restart | status
#
# Lives in ~/bannerlord/ next to run-server.sh, linked as ~/.local/bin/mpm; mpManager's scripts/deploy.sh (run-server.sh: mpServerConfig's deploy.sh)
# installs both. Commands go to MPManager's control socket (control.sock), which answers them; the server's
# own console input doesn't work on Linux. Logs come from mpmanager.log, which MPManager writes as lines are
# printed; server.log is screen's raw copy of the console, for anything missing there.

set -uo pipefail

# Resolve the ~/.local/bin/mpm symlink to the script's real folder.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SELF")"
RUN_SERVER="$SCRIPT_DIR/run-server.sh"
LOG_FILE="$SCRIPT_DIR/mpmanager.log"
CONTROL_SOCKET="$SCRIPT_DIR/control.sock"
METRICS_DIR="$SCRIPT_DIR/metrics"
SERVER_PATTERN="^dotnet TaleWorlds.Starter.DotNetCore.Linux.dll"

# Lines "mpm logs" and "mpm cmd" hide (extended regexes). Add more as needed.
NOISE=(
  'ClientRestSessionTask::'                   # lobby request bookkeeping
  'Http post request\('                       # lobby request retries that succeeded
  '^[^ ]+ [^ ]+ (opening|Loading xml file|Loading assembly|Assembly load result|Loading localized text)'
  '^[^ ]+ [^ ]+ (Searching |Found [0-9]+ )'   # startup scans
  'HasSpawnedAgentVisuals = false'            # per-player network sync
  '^[^ ]+ [^ ]+ (human sending|agent not sending|agents sending end)'
  '^[^ ]+ [^ ]+ peer: .* index: [0-9]+ name: '
  "Can't send the info of|isDisconnectedPeer:|networkPeer\.|peer == networkPeer"
)

usage () {
  sed -n '4,12p' "$SELF" | sed 's/^# \{0,1\}//'
}

filter () {
  grep --line-buffered -a -v -E -f <(printf '%s\n' "${NOISE[@]}")
}

command="${1:-}"
[ $# -gt 0 ] && shift
case "$command" in
  cmd)
    [ $# -gt 0 ] || { echo "Usage: mpm cmd <command...>" >&2; exit 1; }
    [ -S "$CONTROL_SOCKET" ] || { echo "Server is not taking commands (not running, or started without MPManager)." >&2; exit 1; }
    # One command per connection; the server answers with what the command printed, then closes. -t: how long
    # to wait for the answer after sending (map loads can hold the server up for a few seconds).
    if ! reply="$(printf '%s
' "$*" | socat -t 35 - UNIX-CONNECT:"$CONTROL_SOCKET" 2>/dev/null)"; then
      echo "Server is not taking commands (not running, or started without MPManager)." >&2
      exit 1
    fi
    if [ -n "$reply" ]; then printf '%s
' "$reply"; else echo "(done, nothing printed)"; fi
    ;;
  logs)
    follow=""
    lines=50
    all=0
    while [ $# -gt 0 ]; do
      case "$1" in
        -f) follow="-F" ;;
        -n) lines="${2:?-n needs a number}"; shift ;;
        --all) all=1 ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
      esac
      shift
    done
    if [ "$all" = 1 ]; then
      tail -n "$lines" $follow "$LOG_FILE"
    else
      # Filter first, then take the last N, so N counts shown lines; then follow new lines.
      filter < "$LOG_FILE" | tail -n "$lines"
      if [ -n "$follow" ]; then
        tail -n 0 -F "$LOG_FILE" 2>/dev/null | filter
      fi
    fi
    ;;
  perf)
    lines=12
    kind=server
    while [ $# -gt 0 ]; do
      case "$1" in
        -n) lines="${2:?-n needs a number}"; shift ;;
        --players) kind=players ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
      esac
      shift
    done
    file="$(ls -1t "$METRICS_DIR"/"$kind"-*.csv 2>/dev/null | head -n 1)"
    [ -n "$file" ] || { echo "No metrics yet in $METRICS_DIR." >&2; exit 1; }
    echo "$file"
    { head -n 1 "$file"; tail -n +2 "$file" | tail -n "$lines"; } | column -t -s,
    ;;
  start)
    "$RUN_SERVER" -d "$@"
    ;;
  stop)
    "$RUN_SERVER" --stop
    ;;
  restart)
    "$RUN_SERVER" --stop && "$RUN_SERVER" -d "$@"
    ;;
  status)
    if pgrep -f "$SERVER_PATTERN" >/dev/null; then echo "Server is running."; else echo "Server is not running."; fi
    ;;
  ""|-h|--help|help)
    usage
    ;;
  *)
    echo "Unknown command: $command" >&2
    usage >&2
    exit 1
    ;;
esac
