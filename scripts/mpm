#!/usr/bin/env bash
# Controls the test server from this machine, over ssh.
#
# Usage: scripts/mpm <command> [args]
#   console              interactive console: live log + type commands (Ctrl-D to leave)
#   cmd <command...>     run one console command, e.g. scripts/mpm cmd mpm_lobby
#   logs [-f] [-n N]     show the last N (default 100) log lines, -f to follow
#   start [options]      start the server detached; options go to run-server.sh (e.g. --config x.txt)
#   stop                 stop the server
#   restart [options]    stop, then start
#   status               is the server running?
#   attach               attach to the raw screen session (Ctrl-A D to detach)
#   deploy [options]     build and install MPManager and the server scripts (see scripts/deploy.sh)
#
# MPM_HOST overrides the ssh target (default: aesten@7900x).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOST="${MPM_HOST:-aesten@7900x}"
REMOTE="bannerlord" # relative to the remote home directory

usage () {
  sed -n '4,15p' "$0" | sed 's/^# \{0,1\}//'
}

# Log filter matching console.sh: drop the engine's \r and blank lines.
CLEAN="sed -u -e 's/\r//g' -e '/^[[:space:]]*\$/d'"

command="${1:-}"
[ $# -gt 0 ] && shift
case "$command" in
  console)
    ssh -t "$HOST" "\$HOME/$REMOTE/console.sh"
    ;;
  cmd)
    [ $# -gt 0 ] || { echo "Usage: mpm cmd <command...>" >&2; exit 1; }
    # The command goes over stdin, so it needs no quoting for the remote shell.
    printf '%s\n' "$*" | ssh "$HOST" "timeout 3 sh -c 'cat > \"\$HOME/$REMOTE/console.fifo\"'" \
      || { echo "Server is not reading commands (not running, or started without MPManager)." >&2; exit 1; }
    # The log is flushed every second; then show everything from the echo of this command on.
    sleep 2
    ssh "$HOST" "L=\"\$HOME/$REMOTE/server.log\"; n=\$(grep -an '\[MPManager\] > ' \"\$L\" | tail -n 1 | cut -d: -f1); [ -n \"\$n\" ] && tail -n +\$n \"\$L\" | $CLEAN | head -n 40"
    ;;
  logs)
    FOLLOW=""
    LINES=100
    while [ $# -gt 0 ]; do
      case "$1" in
        -f) FOLLOW="-F" ;;
        -n) LINES="${2:?-n needs a number}"; shift ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
      esac
      shift
    done
    # The log has a blank line after every message, so read twice as many lines.
    ssh -t "$HOST" "tail -n $((LINES * 2)) $FOLLOW \"\$HOME/$REMOTE/server.log\" | $CLEAN"
    ;;
  start)
    ssh "$HOST" "\"\$HOME/$REMOTE/run-server.sh\" -d$( [ $# -gt 0 ] && printf ' %q' "$@" )"
    ;;
  stop)
    ssh "$HOST" "\"\$HOME/$REMOTE/run-server.sh\" --stop"
    ;;
  restart)
    ssh "$HOST" "\"\$HOME/$REMOTE/run-server.sh\" --stop && \"\$HOME/$REMOTE/run-server.sh\" -d$( [ $# -gt 0 ] && printf ' %q' "$@" )"
    ;;
  status)
    ssh "$HOST" "pgrep -f '^dotnet TaleWorlds.Starter.DotNetCore.Linux.dll' >/dev/null && echo 'Server is running.' || echo 'Server is not running.'"
    ;;
  attach)
    ssh -t "$HOST" "screen -r bannerlord"
    ;;
  deploy)
    "$SCRIPT_DIR/deploy.sh" "$@"
    ;;
  ""|-h|--help|help)
    usage
    ;;
  *)
    echo "Unknown command: $command" >&2
    usage >&2
    exit 1
    ;;
esac
