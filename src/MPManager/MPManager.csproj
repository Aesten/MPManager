<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The Dedicated Server runs on .NET 6 (see its *.runtimeconfig.json). -->
    <TargetFramework>net6.0</TargetFramework>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>MPManager</AssemblyName>
    <RootNamespace>MPManager</RootNamespace>

    <!-- Dedicated Server install to compile against. Override with: dotnet build -p:DSDir="..." -->
    <DSDir Condition="'$(DSDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Mount &amp; Blade II Dedicated Server</DSDir>
    <DSBin>$(DSDir)\bin\Win64_Shipping_Server</DSBin>

    <ModuleDir>$(MSBuildThisFileDirectory)..\..\dist\Modules\MPManager\</ModuleDir>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(DSBin)\TaleWorlds.Core.dll" Private="false" />
    <Reference Include="$(DSBin)\TaleWorlds.Diamond.dll" Private="false" />
    <Reference Include="$(DSBin)\TaleWorlds.DotNet.dll" Private="false" />
    <Reference Include="$(DSBin)\TaleWorlds.Engine.dll" Private="false" />
    <Reference Include="$(DSBin)\TaleWorlds.Library.dll" Private="false" />
    <Reference Include="$(DSBin)\TaleWorlds.Localization.dll" Private="false" />
    <Reference Include="$(DSBin)\TaleWorlds.ModuleManager.dll" Private="false" />
    <Reference Include="$(DSBin)\TaleWorlds.MountAndBlade.dll" Private="false" />
    <Reference Include="$(DSBin)\TaleWorlds.MountAndBlade.DedicatedCustomServer.dll" Private="false" />
    <Reference Include="$(DSBin)\TaleWorlds.MountAndBlade.Diamond.dll" Private="false" />
    <Reference Include="$(DSBin)\TaleWorlds.MountAndBlade.ListedServer.dll" Private="false" />
    <Reference Include="$(DSBin)\TaleWorlds.MountAndBlade.Multiplayer.dll" Private="false" />
    <Reference Include="$(DSBin)\TaleWorlds.ObjectSystem.dll" Private="false" />
    <Reference Include="$(DSBin)\TaleWorlds.PlayerServices.dll" Private="false" />
  </ItemGroup>

  <!-- Assembles dist/Modules/MPManager from the build output.
       The server loads module DLLs from bin/<name of its working directory>, which is
       Linux64_Shipping_Server on Linux and Win64_Shipping_Server on Windows. Ship both. -->
  <Target Name="AssembleModule" AfterTargets="Build">
    <ItemGroup>
      <ModuleBinFile Include="$(OutDir)$(AssemblyName).dll;$(OutDir)$(AssemblyName).pdb" />
    </ItemGroup>
    <RemoveDir Directories="$(ModuleDir)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\module\SubModule.xml" DestinationFolder="$(ModuleDir)" />
    <Copy SourceFiles="@(ModuleBinFile)" DestinationFolder="$(ModuleDir)bin\Linux64_Shipping_Server\" />
    <Copy SourceFiles="@(ModuleBinFile)" DestinationFolder="$(ModuleDir)bin\Win64_Shipping_Server\" />
  </Target>

</Project>
